# --- Core ---
APP_NAME=AI Quiz Generator
DEBUG=true

# --- Database ---
# Dev (default): SQLite. Production example (Postgres):
# DATABASE_URL=postgresql+psycopg://quiz:quizpass@localhost:5432/quizdb
DATABASE_URL=sqlite:///./quiz.db

# --- Security (CHANGE THESE IN PRODUCTION) ---
# Generate SECRET_KEY:    python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-ME-dev-secret-key-please-override-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Generate ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- CORS (frontend origins) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Uploads ---
MAX_UPLOAD_MB=20
